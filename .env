# FIDO2 Demo configuration
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/fido2-demo

# Relying Party (RP) settings - IMPORTANT for WebAuthn
# For local development:
RP_ID=localhost
ORIGIN=http://localhost:3000
RP_NAME=FIDO2 Demo

# For production behind reverse proxy / custom domain, change to e.g.
# RP_ID=auth.example.com
# ORIGIN=https://auth.example.com
# And ensure your site is served over HTTPS (required for WebAuthn in most cases)

SESSION_SECRET=change-this-to-a-long-random-string-in-production